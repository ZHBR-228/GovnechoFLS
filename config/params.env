# GovnechoFLS — LFS build parameters (BOOK = Linux From Scratch 12.3, SysV)
LFS_VERSION="GovnechoFLS-1.0.0"
BOOK_VERSION="12.3"

# Хостовые требования
MIN_HOST_RAM_MB=1536
MIN_DISK_MB=40960

# Разделы и точки монтирования
LFS_TARGET="/mnt/lfs"
LFS_TGT="$(uname -m)-lfs-linux-gnu"
GOLFS_PREFIX=/tools
GOVERNCH_SRC=/sources
GOVERNCH_BLD=/build

# Ядро: встроенное в GovnechoFLS (не LFS proper, а наше ядро для live/run)
KERNEL_VERSION="6.9.8"
KERNEL_NAME="govecho"

# Пакеты Chapter 5 (toolchain) — версии из BLFS/LFS 12.3
PKG_LINUX_API_HEADERS="6.9.8"
PKG_GCC="14.2.0"
PKG_BINUTILS="2.43.1"
PKG_GLIBC="2.40"

# Пакеты Chapter 6 (система) — LFS 12.3
declare -A SYS_PKGS=(
 [m4]="1.4.19"
 [make]="4.4.1"
 [binutils]="2.43.1"
 [gcc]="14.2.0"
 [linux-libre-headers]="6.9.8"
 [glibc]="2.40"
 [tzdata]="2024a"
 [file]="5.45"
 [gettext]="0.22.5"
 [openssl]="3.3.2"
 [kmod]="32"
 [libelf]="0.191"
 [bzip2]="1.0.8"
 [coreutils]="9.5"
 [diffutils]="3.10"
 [e2fsprogs]="1.47.1"
 [findutils]="4.10.0"
 [gperf]="3.1"
 [grep]="3.12"
 [gzip]="1.13"
 [iperf3]="3.17.1"
 [kbd]="2.6.4"
 [libpipeline]="1.5.3"
 [libsigsegv]="1.14"
 [libtool]="2.4.7"
 [popt]="1.19"
 [ncurses]="6.5"
 [sed]="4.9"
 [tar]="1.35"
 [texinfo]="7.1"
 [util-linux]="2.40.2"
 [pkg-config-lite]="0.29.2"
 [shadow]="4.16.0"
 [bc]="1.07.1"
 [bash]="5.2.32"
 [iproute2]="6.9.0"
 [procps-ng]="4.0.4"
 [sysvinit]="3.09"
 [eudev]="3.2.14"
 [kbd-extras]=""
 [acl]="2.3.2"
 [attr]="2.5.2"
 [polkit-prereq]=""
 [zlib]="1.3.1"
 [bison]="3.8.2"
 [flex]="2.6.4"
 [grub]="2.12"
)

# Govnecho-компоненты (наши собственные, всегда собираются статически)
GOVECHO_SRC_DIR="src"   # govecho.c govinit.c govwelcome.c govctl.c govechoos-release.c
