# GovnechoFLS — LFS build parameters (BOOK = Linux From Scratch 12.3, SysV)
LFS_VERSION="GovnechoFLS-1.0.0"
BOOK_VERSION="12.3"

# Хостовые требования
MIN_HOST_RAM_MB=1536
MIN_DISK_MB=40960

# Разделы и точки монтирования
LFS_TARGET="/mnt/lfs"
LFS_TGT="$(uname -m)-lfs-linux-gnu"
GOLFS_PREFIX=/tools
GOVERNCH_SRC=/sources
GOVERNCH_BLD=/build

# Ядро: встроенное в GovnechoFLS (не LFS proper, а наше ядро для live/run)
KERNEL_VERSION="6.9.8"
KERNEL_NAME="govecho"

# GNOME-стек и ряд стартовых программ (BLFS-версии, LFS BOOK 12.3 / BLFS 12.3)
declare -A GNOME_STACK=(
 [xml2-utils]="2.11.5"   # libxml2+libxslt утилиты (BLFS ch.7)
 [itstool]="2.0.7"
 [gobject-introspection]="1.82.2"
 [shared-mime-info]="2.4"
 [iso-codes]="4.16.0"
 [adwaita-icon-theme]="46.1"
 [at-spi2-core]="2.52.0"
 [at-spi2-atk]="2.38.1"
 [libepoxy]="1.5.10"
 [libjpeg-turbo]="3.0.2"
 [graphene]="1.10.8"
 [harfbuzz]="9.0.0"
 [freetype]="2.13.2"
 [fontconfig]="2.15.0"
 [gdk-pixbuf]="2.42.12"
 [startup-notification]="0.12"
 [dconf]="0.40.0"
 [gsettings-desktop-schemas]="46.1"
 [json-glib]="1.10.2"
 [libsoup]="3.4.4"
 [accountsservice]="23.13.6"
 [udisks]="2.10.1"
 [upower]="1.90.4"
 [polkit]="124"
 [networkmanager]="1.48.8"
 [gnome-desktop]="46.1"
 [mutter]="46.2"
 [gnome-shell]="46.4"
 [gnome-session]="46.0"
 [gdm]="46.2"
 [gjs]="1.82.3"
 [evolution-data-server]="3.52.3"
)

# Ряд стартовых программ GovnechoFLS (BLFS-сборка из исходников)
declare -A STARTUP_APPS=(
 [nautilus]="46.0"           # Файлы
 [gnome-terminal]="3.52.0"   # Терминал
 [gedit]="46.0"              # Текстовый редактор
 [gnome-calculator]="46.0"   # Калькулятор
 [gnome-system-monitor]="46.0" # Монитор системы
 [firefox]="129.0"           # Браузер (ESR-подобная сборка)
 [htop]="3.3.0"              # Консольный монитор
 [fish]="3.7.1"              # Альтернативный шелл
)

# Пакеты Chapter 5 (toolchain) — версии из BLFS/LFS 12.3
PKG_LINUX_API_HEADERS="6.9.8"
PKG_GCC="14.2.0"
PKG_BINUTILS="2.43.1"
PKG_GLIBC="2.40"

# Пакеты Chapter 6 (система) — LFS 12.3
declare -A SYS_PKGS=(
 [m4]="1.4.19"
 [make]="4.4.1"
 [binutils]="2.43.1"
 [gcc]="14.2.0"
 [linux-libre-headers]="6.9.8"
 [glibc]="2.40"
 [tzdata]="2024a"
 [file]="5.45"
 [gettext]="0.22.5"
 [openssl]="3.3.2"
 [kmod]="32"
 [libelf]="0.191"
 [bzip2]="1.0.8"
 [coreutils]="9.5"
 [diffutils]="3.10"
 [e2fsprogs]="1.47.1"
 [findutils]="4.10.0"
 [gperf]="3.1"
 [grep]="3.12"
 [gzip]="1.13"
 [iperf3]="3.17.1"
 [kbd]="2.6.4"
 [libpipeline]="1.5.3"
 [libsigsegv]="1.14"
 [libtool]="2.4.7"
 [popt]="1.19"
 [ncurses]="6.5"
 [sed]="4.9"
 [tar]="1.35"
 [texinfo]="7.1"
 [util-linux]="2.40.2"
 [pkg-config-lite]="0.29.2"
 [shadow]="4.16.0"
 [bc]="1.07.1"
 [bash]="5.2.32"
 [iproute2]="6.9.0"
 [procps-ng]="4.0.4"
 [sysvinit]="3.09"
 [eudev]="3.2.14"
 [kbd-extras]=""
 [acl]="2.3.2"
 [attr]="2.5.2"
 [polkit-prereq]=""
 [zlib]="1.3.1"
 [bison]="3.8.2"
 [flex]="2.6.4"
 [grub]="2.12"
)

# Govnecho-компоненты (наши собственные, всегда собираются статически)
GOVECHO_SRC_DIR="src"   # govecho.c govinit.c govwelcome.c govctl.c govechoos-release.c
